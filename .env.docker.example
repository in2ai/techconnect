TECHCONNECT_HTTP_PORT=8080

POSTGRES_DB=techconnect
POSTGRES_USER=techconnect
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql://techconnect:change-me@db:5432/techconnect

AUTH_BOOTSTRAP_EMAIL=admin@techconnect.local
AUTH_BOOTSTRAP_PASSWORD=strong-admin-password
AUTH_BOOTSTRAP_FULL_NAME="TechConnect Administrator"

# Send the session cookie only over HTTPS. Keep true in production; set to
# false only when testing over plain HTTP, or login will not persist.
AUTH_COOKIE_SECURE=true
# Session lifetime in minutes (default 720 = 12 h).
AUTH_SESSION_TTL_MINUTES=720

# Optional: terminate HTTPS in a container instead of a host-level Nginx
# (publishes ports 80 and 443). The directory must contain techconnect.crt
# and techconnect.key. See docs/despliegue-produccion-hospital.md, section 6A.
# COMPOSE_FILE=compose.yaml:compose.tls.yaml
# TECHCONNECT_TLS_DIR=/etc/techconnect/tls
